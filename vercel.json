{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/apple-touch-icon.png", "destination": "/apple-touch-icon.png" },
    { "source": "/icon-512.png", "destination": "/icon-512.png" },
    { "source": "/og-image.png", "destination": "/og-image.png" },
    { "source": "/logo.svg", "destination": "/logo.svg" },
    { "source": "/logo-header.svg", "destination": "/logo-header.svg" },
    { "source": "/logo-header-dark.svg", "destination": "/logo-header-dark.svg" },
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/version.json", "destination": "/version.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}