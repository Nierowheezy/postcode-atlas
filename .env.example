# ---------------------------------------------------------------------------
# Gemini API
# ---------------------------------------------------------------------------
# Injected at runtime from the deployment platform's secret store.
# Configure this in the Secrets / Environment Variables panel of your host
# (Vercel: Project Settings -> Environment Variables).
# Never commit a real key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# NIPOST Digital Postcode API (NDAPS)
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values.
#
# This app is deployed as a static bundle and calls api.postcode.gov.ng
# directly from the browser, so the key MUST be the publishable `nipost_pk_`
# tier. Anything in a VITE_ variable is readable in the shipped JavaScript.
# Never put a secret `sk_` key here.

VITE_NIPOST_API_BASE_URL="https://api.postcode.gov.ng"
VITE_NIPOST_PUBLISHABLE_KEY="nipost_pk_your_publishable_key_here"